# Copier en .env.local (jamais commité) pour publier le backend de ce PC sur
# internet avec Tailscale Funnel, au service du site ClipFlow en ligne.
# Sans ce fichier, ClipFlow reste uniquement local, comme avant.

# Le même code que celui du Space Hugging Face et du site en ligne.
CLIPFLOW_ACCESS_CODE=

# L'adresse du site ClipFlow en ligne (Vercel), autorisée à appeler ce PC.
CLIPFLOW_CORS_ORIGINS=https://clipflow.vercel.app
